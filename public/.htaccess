<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Vite's hashed asset filenames change on every build, so these are safe
  # to cache forever — a new deploy is always a new URL.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html (and the PWA manifest/service worker) keep the SAME URL across
  # deploys, so a CDN or browser caching this is exactly what makes a new
  # deploy invisible to returning visitors — force revalidation every time.
  <FilesMatch "^(index\.html|manifest\.json|sw\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # App/PWA icons also keep the SAME URL across deploys (unlike hashed JS/CSS)
  # — this is exactly what silently kept serving the old logo through
  # Cloudflare's edge cache after the icon files themselves were replaced.
  # Short max-age instead of no-cache: these change rarely, but when they do,
  # every layer (browser + CDN) needs to actually re-check within the hour.
  <FilesMatch "\.(png|ico|svg)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Direct all API requests directly to the PHP REST API
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # Clean share-link URLs (no /api/v1 prefix) — same crawler-aware
  # preview + redirect handler in api/index.php, matched by URI suffix
  # regardless of prefix, see GET /share/job/{id} there.
  RewriteRule ^share/(job|company)/[^/]+$ api/index.php [QSA,L]

  # Frontend Single Page App fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
